{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🧹 Maven Clean",
      "type": "shell",
      "command": "mvn clean",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📦 Maven Compile",
      "type": "shell",
      "command": "mvn compile -DskipTests",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🏗️ Maven Install",
      "type": "shell",
      "command": "mvn clean install -DskipTests",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧪 Maven Test",
      "type": "shell",
      "command": "mvn test",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🚀 Start Local (Script)",
      "type": "shell",
      "command": "./scripts/start-local.sh",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🛑 Stop Service",
      "type": "shell",
      "command": "./scripts/stop-service.sh",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🏥 Check Health",
      "type": "shell",
      "command": "./scripts/check-health.sh",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🐳 Docker Compose Up",
      "type": "shell",
      "command": "docker-compose up -d",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🛑 Docker Compose Down",
      "type": "shell",
      "command": "docker-compose down",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}

