  ],
  "java.jdt.ls.java.home": "/Users/jguerreroh/Library/Java/JavaVirtualMachines/corretto-17.0.16/Contents/Home",
  // Maven Configuration
  "maven.executable.path": "mvn",
  "maven.terminal.useJavaHome": true,
  "maven.terminal.customEnv": [
    {
