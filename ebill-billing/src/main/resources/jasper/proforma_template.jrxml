<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="Proforma" pageWidth="595" pageHeight="842" columnWidth="535"
    leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <!-- Parámetros -->
    <parameter name="logoUrl" class="java.net.URL"/>
    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="companyRuc" class="java.lang.String"/>
    <parameter name="companyAddress" class="java.lang.String"/>
    <parameter name="companyTradeName" class="java.lang.String"/>
    <parameter name="companyHeadOfficeAddress" class="java.lang.String"/>
    <parameter name="companyBranchOfficeAddress" class="java.lang.String"/>
    <parameter name="proformaNumber" class="java.lang.String"/>
    <parameter name="issueDate" class="java.lang.String"/>
    <parameter name="validUntil" class="java.lang.String"/>
    <parameter name="clientName" class="java.lang.String"/>
    <parameter name="clientIdentification" class="java.lang.String"/>
    <parameter name="clientAddress" class="java.lang.String"/>
    <parameter name="additionalInformation" class="java.lang.String"/>
    <parameter name="subtotalZero" class="java.lang.String"/>
    <parameter name="subtotalIva" class="java.lang.String"/>
    <parameter name="subtotalIce" class="java.lang.String"/>
    <parameter name="totalDiscount" class="java.lang.String"/>
    <parameter name="totalAmount" class="java.lang.String"/>

    <!-- Campos de detalle -->
    <field name="productCode" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.lang.String"/>
    <field name="unitPrice" class="java.lang.String"/>
    <field name="discount" class="java.lang.String"/>
    <field name="subtotal" class="java.lang.String"/>

    <title>
        <band height="140">
            <!-- Logo encima del nombre de la compañía -->
            <image scaleImage="RetainShape">
                <reportElement x="0" y="0" width="80" height="60"/>
                <imageExpression><![CDATA[$P{logoUrl}]]></imageExpression>
            </image>

            <!-- Datos de la compañía a la derecha del logo, pero empezando debajo del logo -->
            <textField>
                <reportElement x="0" y="70" width="350" height="16"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyName} == null ? "" : $P{companyName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="88" width="350" height="14"/>
                <textElement>
                    <font size="10" isBold="false"/>
                </textElement>
                <textFieldExpression><![CDATA["Nombre Comercial: " + ($P{companyTradeName} == null ? "" : $P{companyTradeName})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="104" width="350" height="14"/>
                <textElement>
                    <font size="10" isBold="false"/>
                </textElement>
                <textFieldExpression><![CDATA["Dir. Matriz: " + ($P{companyHeadOfficeAddress} == null ? "" : $P{companyHeadOfficeAddress})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="120" width="350" height="14"/>
                <textElement>
                    <font size="10" isBold="false"/>
                </textElement>
                <textFieldExpression><![CDATA["Dir. Sucursal: " + ($P{companyBranchOfficeAddress} == null ? "" : $P{companyBranchOfficeAddress})]]></textFieldExpression>
            </textField>

            <!-- RUC y datos de cabecera en el recuadro derecho -->
            <textField>
                <reportElement x="360" y="0" width="175" height="16"/>
                <textElement textAlignment="Right">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["RUC: " + ($P{companyRuc} == null ? "" : $P{companyRuc})]]></textFieldExpression>
            </textField>

            <!-- Título PROFORMA -->
            <staticText>
                <reportElement x="360" y="18" width="175" height="18"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[PROFORMA]]></text>
            </staticText>
            <!-- Número de proforma en rojo -->
            <textField>
                <reportElement x="360" y="34" width="175" height="16" forecolor="#FF0000"/>
                <textElement textAlignment="Right">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No.: " + $P{proformaNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="52" width="175" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Emisión: " + $P{issueDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="70" width="175" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Válida hasta: " + $P{validUntil}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="80">
            <frame>
                <reportElement x="0" y="0" width="535" height="60" backcolor="#EFEFEF" mode="Opaque"/>
                <staticText>
                    <reportElement x="5" y="4" width="140" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Cliente:]]></text>
                </staticText>
                <textField>
                    <reportElement x="150" y="4" width="380" height="14"/>
                    <textFieldExpression><![CDATA[$P{clientName}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="5" y="22" width="140" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Identificación:]]></text>
                </staticText>
                <textField>
                    <reportElement x="150" y="22" width="380" height="14"/>
                    <textFieldExpression><![CDATA[$P{clientIdentification}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="5" y="40" width="140" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Dirección:]]></text>
                </staticText>
                <textField>
                    <reportElement x="150" y="40" width="380" height="14"/>
                    <textFieldExpression><![CDATA[$P{clientAddress}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="0" y="62" width="535" height="18" backcolor="#DFDFDF" mode="Opaque"/>
                <staticText>
                    <reportElement x="5" y="2" width="80" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Código]]></text>
                </staticText>
                <staticText>
                    <reportElement x="90" y="2" width="220" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Descripción]]></text>
                </staticText>
                <staticText>
                    <reportElement x="315" y="2" width="50" height="14"/>
                    <textElement textAlignment="Right">
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Cant.]]></text>
                </staticText>
                <staticText>
                    <reportElement x="370" y="2" width="55" height="14"/>
                    <textElement textAlignment="Right">
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Precio]]></text>
                </staticText>
                <staticText>
                    <reportElement x="430" y="2" width="55" height="14"/>
                    <textElement textAlignment="Right">
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Desc. %]]></text>
                </staticText>
                <staticText>
                    <reportElement x="490" y="2" width="45" height="14"/>
                    <textElement textAlignment="Right">
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Total]]></text>
                </staticText>
            </frame>
        </band>
    </pageHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="5" y="0" width="80" height="16"/>
                <textFieldExpression><![CDATA[$F{productCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="90" y="0" width="220" height="16"/>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="315" y="0" width="50" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="0" width="55" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="0" width="55" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{discount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="490" y="0" width="45" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="120">
            <frame>
                <reportElement x="0" y="0" width="320" height="60" backcolor="#F8F8F8" mode="Opaque"/>
                <staticText>
                    <reportElement x="10" y="4" width="200" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Información adicional]]></text>
                </staticText>
                <textField textAdjust="StretchHeight">
                    <reportElement x="10" y="20" width="300" height="36"/>
                    <textFieldExpression><![CDATA[$P{additionalInformation}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="325" y="0" width="210" height="120" backcolor="#F8F8F8" mode="Opaque"/>

                <staticText>
                    <reportElement x="5" y="4" width="120" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Subtotal 0%]]></text>
                </staticText>
                <textField>
                    <reportElement x="130" y="4" width="75" height="14"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$P{subtotalZero}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="5" y="22" width="120" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Subtotal IVA]]></text>
                </staticText>
                <textField>
                    <reportElement x="130" y="22" width="75" height="14"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$P{subtotalIva}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="5" y="40" width="120" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Subtotal ICE]]></text>
                </staticText>
                <textField>
                    <reportElement x="130" y="40" width="75" height="14"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$P{subtotalIce}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="5" y="58" width="120" height="14"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <text><![CDATA[Descuento]]></text>
                </staticText>
                <textField>
                    <reportElement x="130" y="58" width="75" height="14"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$P{totalDiscount}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="5" y="80" width="120" height="16"/>
                    <textElement>
                        <font size="11" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Total]]></text>
                </staticText>
                <textField>
                    <reportElement x="130" y="80" width="75" height="16"/>
                    <textElement textAlignment="Right">
                        <font size="11" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{totalAmount}]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </summary>
</jasperReport>

