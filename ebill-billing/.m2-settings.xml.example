<!-- 
  Configuración de Maven para acceder a repositorios privados de GitLab
  
  INSTRUCCIONES:
  1. Copia este archivo a: ~/.m2/settings.xml
  2. Reemplaza YOUR_GITLAB_TOKEN con tu token personal de GitLab
  3. Para obtener un token:
     - Ve a GitLab: https://85.239.237.88
     - Menú Usuario > Preferences > Access Tokens
     - Crea un token con scope: api, read_repository
  
  NOTA: NO compartas este archivo ni lo agregues al control de versiones
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  
  <servers>
    <!-- ebill-utils repository -->
    <server>
      <id>gitlab-ebill-utils</id>
      <configuration>
        <httpHeaders>
          <property>
            <name>Private-Token</name>
            <value>YOUR_GITLAB_TOKEN</value>
          </property>
        </httpHeaders>
      </configuration>
    </server>
    
    <!-- ebill-auth-util repository -->
    <server>
      <id>gitlab-ebill-auth-util</id>
      <configuration>
        <httpHeaders>
          <property>
            <name>Private-Token</name>
            <value>YOUR_GITLAB_TOKEN</value>
          </property>
        </httpHeaders>
      </configuration>
    </server>
  </servers>
  
  <!-- Opcional: Configurar proxy si es necesario -->
  <!--
  <proxies>
    <proxy>
      <id>optional-proxy</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>proxy.example.com</host>
      <port>8080</port>
      <username>proxyuser</username>
      <password>proxypass</password>
      <nonProxyHosts>localhost|127.0.0.1</nonProxyHosts>
    </proxy>
  </proxies>
  -->
  
  <!-- Opcional: Configurar mirror para Maven Central -->
  <!--
  <mirrors>
    <mirror>
      <id>maven-central</id>
      <name>Maven Central Mirror</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
  -->

</settings>



