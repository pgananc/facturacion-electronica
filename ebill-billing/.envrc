# Configuración automática del entorno
# Este archivo configura JAVA_HOME automáticamente cuando entras al directorio
# Requiere direnv: brew install direnv

export JAVA_HOME="/Users/jguerreroh/Library/Java/JavaVirtualMachines/corretto-17.0.16/Contents/Home"
export PATH="$JAVA_HOME/bin:$PATH"

# Mostrar mensaje
echo "✅ Java 17 activado: $(java -version 2>&1 | head -1)"

