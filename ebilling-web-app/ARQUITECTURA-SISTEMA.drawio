<mxfile host="app.diagrams.net">
  <diagram id="system-architecture" name="Arquitectura Sistema">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="🏗️ Arquitectura del Sistema - eBilling Platform" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        
        <!-- Frontend Layer -->
        <mxCell id="frontend" value="🌐 Frontend Angular SPA&lt;br&gt;localhost:4200&lt;br&gt;&lt;br&gt;• Lazy Loading (6 módulos)&lt;br&gt;• Reactive Forms&lt;br&gt;• RxJS State Management&lt;br&gt;• JWT Authentication&lt;br&gt;• Material Design UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
