        <!-- Authentication Flow -->
        <mxCell id="auth-flow" value="🔑 Flujo de Autenticación&lt;br&gt;&lt;br&gt;1. Login → ebill-authentication&lt;br&gt;2. JWT Token → Frontend (localStorage)&lt;br&gt;3. Token en headers → Todos los MS&lt;br&gt;4. Validación de sesión → ebill-authentication&lt;br&gt;5. Validación de permisos → ebill-authentication + ebill-billing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="80" y="620" width="360" height="140" as="geometry" />
        </mxCell>
        
        <!-- Permission System -->
        <mxCell id="permission-system" value="🔐 Sistema de Permisos&lt;br&gt;&lt;br&gt;• Roles: super_admin, admin, member&lt;br&gt;• Features: Granulares por código&lt;br&gt;• Validación: ROL + PLAN&lt;br&gt;• Caché: Frontend (localStorage)&lt;br&gt;• Endpoints:&lt;br&gt;  - /api/permission/user/features&lt;br&gt;  - /api/permission/validate-feature&lt;br&gt;  - /api/permission/permissions/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="480" y="620" width="360" height="180" as="geometry" />
        </mxCell>
        
        <!-- Data Flow -->
        <mxCell id="data-flow" value="📊 Flujo de Datos Principal&lt;br&gt;&lt;br&gt;• Facturación: Frontend → ebill-billing → SRI&lt;br&gt;• Clientes: Frontend → ebill-customers&lt;br&gt;• Productos: Frontend → ebill-products&lt;br&gt;• Reportes: Frontend → ebill-reports → ebill-billing&lt;br&gt;• Suscripciones: Frontend → ebill-billing&lt;br&gt;• Menús: Frontend → ebill-authentication → Filtrado por permisos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="880" y="620" width="440" height="180" as="geometry" />
        </mxCell>
        
        <!-- Legend -->
        <mxCell id="legend" value="📝 Leyenda&lt;br&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;━━ Línea sólida: Comunicación directa&lt;br&gt;━━ Línea punteada: Comunicación interna MS&lt;br&gt;🔐 = Autenticación / Autorización&lt;br&gt;📋 = Gestión de datos&lt;br&gt;⚙️ = Configuración / Infraestructura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="280" height="140" as="geometry" />
        </mxCell>
        
        <!-- Technology Stack -->
        <mxCell id="tech-stack" value="🛠️ Stack Tecnológico&lt;br&gt;&lt;br&gt;Frontend:&lt;br&gt;• Angular 18&lt;br&gt;• RxJS&lt;br&gt;• Angular Material&lt;br&gt;• TypeScript&lt;br&gt;&lt;br&gt;Backend:&lt;br&gt;• Microservicios REST&lt;br&gt;• JWT Authentication&lt;br&gt;• Spring Boot (asumido)&lt;br&gt;&lt;br&gt;Protocolos:&lt;br&gt;• HTTP/REST&lt;br&gt;• JWT Bearer Tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="840" width="280" height="240" as="geometry" />
        </mxCell>
        
        <!-- Ports Summary -->
        <mxCell id="ports" value="🔌 Puertos del Sistema&lt;br&gt;&lt;br&gt;Frontend:      4200&lt;br&gt;Auth:          8280&lt;br&gt;Customers:     8180&lt;br&gt;Products:      8380&lt;br&gt;Billing:       8480&lt;br&gt;Reports:       8580&lt;br&gt;&lt;br&gt;📌 Desarrollo: localhost&lt;br&gt;📌 Producción: wallparisoft.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="720" y="840" width="280" height="200" as="geometry" />
