        <!-- Key Features -->
        <mxCell id="features" value="⭐ Características Clave&lt;br&gt;&lt;br&gt;✅ Lazy Loading (6 módulos)&lt;br&gt;✅ JWT Authentication&lt;br&gt;✅ Permisos granulares (ROL + PLAN)&lt;br&gt;✅ Caché de permisos (localStorage)&lt;br&gt;✅ Interceptors HTTP (Auth, Errors, Timeout)&lt;br&gt;✅ Reactive Forms&lt;br&gt;✅ Material Design UI&lt;br&gt;✅ Responsive Design&lt;br&gt;✅ Session Management&lt;br&gt;✅ Menu Filtering dinámico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;fontSize=10" vertex="1" parent="1">
