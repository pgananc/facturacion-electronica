        </mxCell>
        
        <!-- Auth Service -->
        <mxCell id="auth-ms" value="🔐 ebill-authentication&lt;br&gt;localhost:8280&lt;br&gt;&lt;br&gt;📋 Endpoints Principales:&lt;br&gt;• /api/login&lt;br&gt;• /api/session/validate&lt;br&gt;• /api/permission/*&lt;br&gt;• /api/menu/{userName}&lt;br&gt;• /api/user/*&lt;br&gt;• /api/role&lt;br&gt;• /api/token/*&lt;br&gt;• /api/admin/menu/*&lt;br&gt;• /api/user-company/*&lt;br&gt;• /api/invoice-points/session/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;fontSize=11" vertex="1" parent="1">
